# Built application files
*.apk
*.aar
*.ap_
*.aab

!libs/*.aar

# Files for the ART/Dalvik VM
*.dex

# Java/JDK files
*.class
*.hprof

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
# Ignore the IDE folder CONTENTS, not the folder itself: git will not descend into an excluded
# directory, so `.idea/` would make the negation below impossible. Shared run configurations are
# the one thing we commit — that's how everyone on the team gets the deploySloth button.
.idea/*
!.idea/runConfigurations/

# For Mac users
.DS_Store

# Build-time manifest (generated by generateBuildManifest Gradle task on every build)
build-manifest.json

# Per-robot SNAPSHOTS pulled off a hub for inspection are records, not canonical — don't commit them
# (their history lives in the RC log's SNAPSHOT: lines). Covers snacktime_snapshot_COMPETITION.json etc.
snacktime_snapshot*.json
# Legacy single-file tuning name (pre per-robot); ignore any stray copy pulled to the repo root.
current_tuning.json
# NOTE: per-robot TUNING files ARE committed, under tuning/ (that's the canonical backup, CLAUDE.md
# §6/§7) — so they are deliberately NOT ignored here.

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/